{
  "images": {
    "extensions": [".jpg", ".jpeg", ".png", ".gif", ".bmp", ".tiff", ".tif", ".webp", ".svg", ".ico", ".heic", ".heif", ".raw", ".cr2", ".nef", ".arw", ".dng", ".psd", ".ai", ".eps"],
    "folder_name": "Images",
    "icon": "🖼️"
  },
  "videos": {
    "extensions": [".mp4", ".mkv", ".avi", ".mov", ".wmv", ".flv", ".webm", ".m4v", ".mpg", ".mpeg", ".3gp", ".ogv", ".ts", ".mts", ".m2ts", ".vob", ".divx"],
    "folder_name": "Videos",
    "icon": "🎬"
  },
  "documents": {
    "extensions": [".pdf", ".doc", ".docx", ".txt", ".rtf", ".odt", ".md", ".tex", ".wpd", ".pages", ".xml", ".csv", ".xls", ".xlsx", ".ppt", ".pptx", ".odp", ".key", ".numbers"],
    "folder_name": "Documents",
    "icon": "📄"
  },
  "audio": {
    "extensions": [".mp3", ".wav", ".flac", ".aac", ".ogg", ".wma", ".m4a", ".opus", ".aiff", ".alac", ".amr", ".mid", ".midi"],
    "folder_name": "Music",
    "icon": "🎵"
  },
  "archives": {
    "extensions": [".zip", ".rar", ".7z", ".tar", ".gz", ".bz2", ".xz", ".tgz", ".tbz2", ".z", ".cab", ".iso", ".dmg"],
    "folder_name": "Archives",
    "icon": "📦"
  },
  "code": {
    "extensions": [".py", ".js", ".html", ".css", ".php", ".java", ".cpp", ".c", ".h", ".go", ".rs", ".rb", ".swift", ".kt", ".ts", ".json", ".yaml", ".yml", ".toml", ".ini", ".cfg", ".sh", ".bash", ".zsh", ".sql", ".r", ".m", ".pl"],
    "folder_name": "Code",
    "icon": "💻"
  },
  "executables": {
    "extensions": [".exe", ".msi", ".app", ".deb", ".rpm", ".sh", ".bat", ".cmd", ".com", ".bin", ".run"],
    "folder_name": "Executables",
    "icon": "⚙️"
  },
  "fonts": {
    "extensions": [".ttf", ".otf", ".woff", ".woff2", ".eot", ".fnt", ".fon"],
    "folder_name": "Fonts",
    "icon": "🔤"
  },
  "databases": {
    "extensions": [".db", ".sqlite", ".sqlite3", ".mdb", ".accdb", ".fdb", ".dbf"],
    "folder_name": "Databases",
    "icon": "🗄️"
  },
  "emails": {
    "extensions": [".eml", ".msg", ".pst", ".ost", ".mbox"],
    "folder_name": "Emails",
    "icon": "📧"
  },
  "web": {
    "extensions": [".html", ".htm", ".xhtml", ".xml", ".rss", ".atom", ".url", ".webloc", ".desktop"],
    "folder_name": "Web",
    "icon": "🌐"
  },
  "system": {
    "extensions": [".dll", ".sys", ".drv", ".inf", ".ini", ".cfg", ".conf", ".log", ".tmp", ".temp", ".bak", ".old"],
    "folder_name": "System",
    "icon": "🖥️"
  },
  "cad_3d": {
    "extensions": [".stl", ".obj", ".fbx", ".blend", ".max", ".ma", ".mb", ".c4d", ".3ds", ".dae", ".step", ".iges", ".dxf", ".dwg"],
    "folder_name": "3D_Models",
    "icon": "🎨"
  },
  "disk_images": {
    "extensions": [".iso", ".img", ".dd", ".vhd", ".vmdk", ".qcow2"],
    "folder_name": "Disk_Images",
    "icon": "💾"
  },
  "others": {
    "extensions": [".torrent", ".nfo", ".srt", ".sub", ".ass", ".cue", ".m3u", ".pls", ".xspf"],
    "folder_name": "Others",
    "icon": "📎"
  }
}